[21.09699999999995, "o", "\u001b[38;5;11m  \ud83d\udcad Would have freed 50.0 MB. Use --nuke to make it real.\r\n"]
[21.09699999999995, "o", "\u001b[0m\r\n"]
[21.902999999999953, "o", "\u001b[2J\u001b[1;1H"]
[21.902999999999953, "o", "\r\n"]
[22.205999999999953, "o", "\u001b[38;2;200;200;200m                     \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\n                     \u2502                  LETTER OF RESIGNATION                   \u2502\r\n                     \u2502                                                          \u2502\r\n                     \u2502 Dear rage-demo,                                          \u2502\r\n"]
[22.286999999999953, "o", "                     \u2502                                                          \u2502\r\n"]
[22.36699999999995, "o", "                     \u2502 After 30 commits spanning less than a day, I             \u2502\r\n"]
[22.44799999999995, "o", "                     \u2502 can no longer pretend this codebase                      \u2502\r\n"]
[22.53299999999995, "o", "                     \u2502 sparks joy.                                              \u2502\r\n"]
[22.61599999999995, "o", "                     \u2502                                                          \u2502\r\n"]
[22.69899999999995, "o", "                     \u2502 Notable grievances:                                      \u2502\r\n"]
[22.78399999999995, "o", "                     \u2502 \u2022 3 file(s) named 'utils' \u2014 original.                \u2502\r\n"]
[22.86799999999995, "o", "                     \u2502 \u2022 4 optimistic TODOs from a younger,                   \u2502\r\n"]
[22.95299999999995, "o", "                     \u2502 \u2022   more innocent developer.                           \u2502\r\n"]
[23.035999999999948, "o", "                     \u2502                                                          \u2502\r\n"]
[23.11799999999995, "o", "                     \u2502 I wish you nothing but segfaults.                        \u2502\r\n"]
[23.20299999999995, "o", "                     \u2502                                                          \u2502\r\n"]
[23.28699999999995, "o", "                     \u2502 Regards,                                                 \u2502\r\n"]
[23.37199999999995, "o", "                     \u2502 A dev who tried                                          \u2502\r\n"]
[23.45699999999995, "o", "                     \u2502                                                          \u2502\r\n"]
[23.55899999999995, "o", "                     \u2502 Date: 2026-04-02                                         \u2502\r\n"]
