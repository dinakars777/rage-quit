[0.303, "o", "\u001b[38;2;200;200;200m                     ┌──────────────────────────────────────────────────────────┐\r\n                     │                  LETTER OF RESIGNATION                   │\r\n                     │                                                          │\r\n                     │ Dear rage-demo,                                          │\r\n"]
[0.083, "o", "                     │                                                          │\r\n"]
